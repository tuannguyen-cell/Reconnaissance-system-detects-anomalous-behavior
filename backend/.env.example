# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Behavior Monitor API
VERSION=0.1.0

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Settings
DATABASE_URL=sqlite+aiosqlite://./behavior_monitor.db

# Model Settings
YOLO_MODEL_PATH=../yolov8n-pose.pt
LSTM_MODEL_PATH=../models/lstm_best.pt
SEQUENCE_LENGTH=30
INPUT_SIZE=51
ANOMALY_THRESHOLD=0.6

# Security Settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Detection Settings
MAX_DETECTION_HISTORY=1000
CONFIDENCE_THRESHOLD=0.25
